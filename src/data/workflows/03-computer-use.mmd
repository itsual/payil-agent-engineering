flowchart TB
  T(["Task on an authorized portal"]) --> API{{"Stable API available?"}}
  API -->|"yes"| USE["Use the API"]
  API -->|"no"| DOM["DOM locator<br/>role, label, accessible name"]
  DOM --> FOUND{{"Exactly one<br/>element found?"}}
  FOUND -->|"yes"| ACT["Perform one action"]
  FOUND -->|"no"| VIS["Visual grounding<br/>screenshot and Set-of-Mark"]
  VIS --> CONF{{"Confidence above<br/>the threshold?"}}
  CONF -->|"yes"| ACT
  CONF -->|"no"| ESC(["Escalate to a human"])
  ACT --> VER{{"Page state matches<br/>the expectation?"}}
  VER -->|"yes"| NEXT(["Next step or finish"])
  VER -->|"modal, logout or<br/>layout change"| REC["Recover or stop safely"]
  REC --> ESC
  EVID[("Evidence log<br/>masked screenshots")]
  ACT -.-> EVID
  classDef step fill:#213f44,stroke:#8cf5d2,color:#edfefa,stroke-width:1.5px;
  classDef gate fill:#2d2950,stroke:#c9b6ff,color:#f7f3ff,stroke-width:1.5px;
  classDef end1 fill:#1d3b2f,stroke:#7be3a8,color:#eafff3,stroke-width:1.5px;
  classDef bad fill:#3c3040,stroke:#f8ca92,color:#fff7eb,stroke-width:1.5px;
  classDef store fill:#18253b,stroke:#97abc3,color:#e8f0fb,stroke-width:1.5px;
  class T,USE,DOM,VIS,ACT,REC step;
  class API,FOUND,CONF,VER gate;
  class NEXT end1;
  class ESC bad;
  class EVID store;
  linkStyle default stroke:#97abc3,stroke-width:1.5px;
