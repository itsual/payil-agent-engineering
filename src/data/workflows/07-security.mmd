flowchart TB
  MAIL["Email from outside<br/>UNTRUSTED CONTENT"] --> A1["Reader agent<br/>has no data-export tools"]
  A1 -->|"summary with provenance label:<br/>external, untrusted"| A2["Worker agent"]
  A2 -->|"proposes a tool call:<br/>export database rows"| PDP{{"Policy decision point<br/>identity, scope, provenance"}}
  PDP -->|"scope not granted"| DENY(["Deny and log"])
  PDP -->|"in scope but sensitive"| HUM["Human confirmation<br/>bound to the exact action"]
  PDP -->|"in scope and low risk"| TOOL["Tool runs with<br/>least privilege"]
  HUM -->|"approved"| TOOL
  HUM -->|"rejected"| DENY
  NOTE["Prompt warnings and text filters<br/>lower the risk but are not the control"] -.-> PDP
  classDef bad fill:#3c3040,stroke:#f8ca92,color:#fff7eb,stroke-width:1.5px;
  classDef step fill:#2d2950,stroke:#c9b6ff,color:#f7f3ff,stroke-width:1.5px;
  classDef gate fill:#213f44,stroke:#8cf5d2,color:#edfefa,stroke-width:1.5px;
  classDef end1 fill:#1d3b2f,stroke:#7be3a8,color:#eafff3,stroke-width:1.5px;
  classDef store fill:#18253b,stroke:#97abc3,color:#e8f0fb,stroke-width:1.5px;
  class MAIL,DENY bad;
  class A1,A2,HUM,TOOL step;
  class PDP gate;
  class NOTE store;
  linkStyle default stroke:#97abc3,stroke-width:1.5px;
